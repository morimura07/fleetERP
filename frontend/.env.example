# ---- Auth (NextAuth / Auth.js) ----
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of THIS web app
AUTH_URL="http://localhost:3000"

# ---- Backend API ----
# Server-side base URL (used by Server Components + the login credential check).
API_URL="http://localhost:4000"
# Browser-visible base URL (used by the client API wrapper). For a cross-origin
# API, set this to the public API origin, e.g. https://api.example.com
NEXT_PUBLIC_API_URL="http://localhost:4000"
