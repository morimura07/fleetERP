# PostgreSQL connection (Neon/Supabase or local). For Neon include ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fleeterp?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# API
PORT=4000
# Comma-separated allowed origins for CORS
CORS_ORIGIN="http://localhost:3000"
