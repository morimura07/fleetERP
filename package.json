{
  "name": "fleeterp",
  "version": "0.1.0",
  "private": true,
  "description": "FleetERP — Transport & Logistics ERP (Next.js + NestJS + PostgreSQL)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @fleeterp/api run prisma:generate",
    "db:migrate": "pnpm --filter @fleeterp/api run prisma:migrate",
    "db:seed": "pnpm --filter @fleeterp/api run prisma:seed",
    "db:reset": "pnpm --filter @fleeterp/api run prisma:reset"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.2.2"
}
