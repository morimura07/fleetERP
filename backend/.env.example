# ---- Database (backend owns Prisma) ----
DATABASE_URL="postgresql://fleetflow:fleetflow@localhost:5432/fleetflow?schema=public"

# ---- Auth (stateless JWT bearer tokens issued to the frontend) ----
# openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES="1d"

# ---- HTTP ----
PORT="4000"
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN="http://localhost:3000"

# ---- SMTP (password reset / notifications) ----
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FleetFlow <no-reply@fleetflow.local>"

# ---- App ----
# Public URL of the frontend, used to build links in emails
APP_URL="http://localhost:3000"
# Local filesystem dir for uploaded proof-of-delivery images
UPLOAD_DIR="./uploads"
