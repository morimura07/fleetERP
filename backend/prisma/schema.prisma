// FleetFlow — 軽貨物運送会社向け配送管理システム
// Prisma schema. PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN // platform operator — creates organizations, the only role that sees across them
  ADMIN // organization administrator — every company inside their own organization
  DISPATCHER
  FINANCE // Finance Controller — GL/AP/AR/budget/tax/payroll, no fleet ops
  DRIVER
  STAFF
}

enum DriverStatus {
  ACTIVE
  VACATION
  INACTIVE
}

enum ContractType {
  EMPLOYEE // 社員
  CONTRACTOR // 業務委託
  PARTTIME // アルバイト
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}

// Driver employment relationship (spec: Driver §3).
enum DriverType {
  COMPANY // company driver
  OWNER_OPERATOR
  SUBCONTRACTOR
}

// Vehicle ownership (spec: Vehicles §4).
enum OwnershipStatus {
  OWNED
  LEASED
  SUBCONTRACTED
}

// Fuel type for a vehicle (spec: Vehicles §4).
enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
  CNG
  OTHER
}

// Warehouse facility classification (spec: Warehouses §1).
enum FacilityType {
  DISTRIBUTION_CENTER
  CROSS_DOCK
  TRANSIT_HUB
  BONDED_WAREHOUSE
  YARD
  OTHER
}

enum JobStatus {
  PENDING // 受付
  WAITING_DISPATCH // 配車待ち
  ASSIGNED // 配車済
  DELIVERING // 配送中
  COMPLETED // 完了
  CANCELLED // キャンセル
}

enum DispatchStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  DISPATCH // 配車通知
  JOB_UPDATE // 案件更新通知
  COMPLETION // 完了通知
  SYSTEM
}

// ───────────────────────── Accounting (Ledger) ─────────────────────────

// Double-entry chart-of-accounts classification.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Financial-statement sub-classification of an account (spec: COA §1).
enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  OPERATING_REVENUE
  OTHER_REVENUE
  COST_OF_SALES // direct costs
  OPERATING_EXPENSE
  OTHER_EXPENSE
  NONE
}

// How an account participates in postings (spec: COA §1, §4).
enum PostingType {
  POSTABLE // accepts direct journal postings
  HEADER // grouping node, no direct postings
  CONTROL // sub-ledger control (AR/AP) — no manual postings
}

// Journal document classification (spec: Journal §1).
enum JournalDocType {
  GENERAL
  ACCRUAL
  DEPRECIATION
  CASH_DISBURSEMENT
  CASH_RECEIPT
  ADJUSTMENT
}

// A journal entry is immutable once POSTED; corrections are made by REVERSED contra-entries.
enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

// ───────────────────────── Freight (Orders & Trips) ─────────────────────────

enum OrderStatus {
  DRAFT // quote / not yet confirmed
  CONFIRMED // accepted by customer, awaiting trip
  IN_TRANSIT // a trip is executing
  DELIVERED // cargo delivered
  INVOICED // AR invoice posted to the ledger
  CANCELLED
}

enum TripStatus {
  PLANNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Northern: Mombasa→Uganda→Rwanda/DRC. Central: Dar es Salaam→Zambia→DRC.
enum CorridorType {
  NORTHERN
  CENTRAL
  DOMESTIC
}

// Conveyance / equipment type for a load (spec: Orders §4, Trips §3).
enum EquipmentType {
  FLATBED
  DRY_VAN
  REEFER // refrigerated
  TANKER
  CONTAINER_20FT
  CONTAINER_40FT
  CURTAIN_SIDE
  LTL // less-than-truckload
  OTHER
}

// Trip cost categories — map 1:1 to expense accounts in the chart of accounts.
enum TripExpenseType {
  FUEL // 5000
  TOLLS // 5010
  BORDER_FEES // 5020
  DRIVER_ALLOWANCE // 5030
  DEMURRAGE // 5040
  MAINTENANCE // 5100
  OTHER
}

// ───────────────────────── AP / AR (M1 / M2) ─────────────────────────

enum PaymentTerm {
  NET_30
  NET_60
  COD // cash on delivery
}

// Credit & Collections (M7) — dunning sequence stage (spec: Collections §4).
enum DunningLevel {
  NONE
  REMINDER // level 1: friendly reminder
  FIRST_NOTICE // level 2
  SECOND_NOTICE // level 3
  FINAL_NOTICE
  LEGAL // handed to legal / debt collection
}

// Dispute lifecycle for a contested invoice (spec: Collections §4).
enum DisputeStatus {
  NONE
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  WRITTEN_OFF
}

// Type of a logged collection activity (spec: Collections §4).
enum CollectionActivityType {
  CALL
  EMAIL
  LETTER
  DUNNING
  PROMISE_TO_PAY
  DISPUTE
  NOTE
  WRITE_OFF
}

enum VendorGroup {
  FUEL_SUPPLIER
  SPARE_PARTS
  CLEARING_AGENT
  SUBCONTRACTED_FLEET
  STATUTORY
  CARRIER // FTL/LTL carrier (spec: Vendor §1)
  FREIGHT_BROKER
  OWNER_OPERATOR
  WORKSHOP // garage / service provider
  OTHER
}

// Vendor remittance method (spec: Vendor §3).
enum PaymentMethod {
  EFT
  WIRE
  CHEQUE
  CASH
  MOBILE_MONEY
  FUEL_CARD
}

// Customer account role (spec: Customer §1).
enum CustomerAccountGroup {
  SOLD_TO
  SHIP_TO
  BILL_TO
  PAYER
}

// Master-data lifecycle for partners (spec: Client §1, Collections §1).
enum PartyStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  PROSPECT
  SUSPENDED
}

// Invoice lifecycle for both AP bills and AR invoices.
//   DRAFT → POSTED (ledger entry created) → PAID (settlement posted) | CANCELLED
enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// ───────────────────────── Phase 2 — Core Finance (M3 / M4 / M5) ─────────────────────────

// Exchange-rate type selectable per posting / consolidation run (PRD §7, M5).
enum RateType {
  SPOT // transaction-date market rate
  AVERAGE // period-average rate (P&L revaluation)
  HISTORICAL // rate at acquisition (equity / fixed assets)
}

// Cash & Bank (M4) — account kind so mobile-money floats are distinguished from banks.
enum BankAccountType {
  BANK // CRDB, KCB, Stanbic … (IBAN/SWIFT)
  MOBILE_MONEY // M-Pesa / Airtel float
  CASH // petty cash drawer
}

// Mobile-money / bank disbursement category to a driver (PRD M4).
enum DisbursementType {
  FUEL_ALLOWANCE
  TOLLS
  BORDER_FEES
  EMERGENCY_REPAIR
  DRIVER_ADVANCE
  OTHER
}

// Disbursement settlement lifecycle, mirroring the external API callback (PRD §5).
//   PENDING → SUCCESS (ledgered) | FAILED | TIMEOUT
enum TransferStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

// Budget kind (M3).
enum BudgetKind {
  CAPEX
  OPEX
}

// Budget control behavior when a posting would exceed the line (PRD M3).
enum BudgetControl {
  STRICT_BLOCK // reject the transaction
  WARNING_ONLY // allow but flag
  OVERRIDE // allow only with director override
}

// ───────────────────────── Phase 3 — Operations (M11 / M12 / M30) ─────────────────────────

// Driver compliance document categories (PRD M11). Each has its own expiry that
// must be flagged before a border crossing.
enum DriverDocType {
  LICENSE // driving licence
  PASSPORT
  COMESA_PERMIT // cross-border transit permit
  YELLOW_FEVER // health certificate
  WORK_PERMIT
  OTHER
}

// Freight-bill reconciliation against the carrier invoice (PRD M12).
enum ReconStatus {
  UNRECONCILED
  MATCHED
  DISCREPANCY
}

// Source of a vehicle position ping. STUB until a telematics provider is wired
// up (PRD §5 live tracking — integration-gated on provider credentials).
enum PositionSource {
  STUB
  GPS
  MANUAL
}

// Inventory (M14)
enum StockCategory {
  SPARE_PART
  FUEL
  TYRE
  LUBRICANT
  CONSUMABLE
  OTHER
}

enum StockUnit {
  PIECE
  LITRE
  KG
  SET
  METRE
  BOX
}

enum StockMovementType {
  RECEIPT // stock in (purchase / return)
  ISSUE // stock out (consumed on a vehicle/trip)
  ADJUSTMENT // stock-take correction (+/−)
  TRANSFER_OUT // moved out of a warehouse (M18)
  TRANSFER_IN // moved into a warehouse (M18)
}

// Procurement (M15)
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIAL // some lines received
  RECEIVED // all lines fully received
  CLOSED // matched & billed
  CANCELLED
}

enum MatchStatus {
  UNMATCHED // no vendor invoice matched yet
  MATCHED // PO ↔ receipt ↔ invoice all agree
  VARIANCE // quantity/price mismatch beyond tolerance
}

// Payroll (M9)
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayRunStatus {
  DRAFT // computed, not approved
  APPROVED // reviewed, ready to post
  POSTED // journal entry posted to the ledger
}

// Expense management (M23) — trip cash-sheet / expense claim lifecycle.
enum ExpenseClaimStatus {
  DRAFT // being filled in
  SUBMITTED // sent for review
  APPROVED // reviewed, ready to post
  POSTED // journal entry posted; advance reconciled
  REJECTED
}

// Fixed Assets (M20)
enum AssetCategory {
  VEHICLE
  EQUIPMENT
  FURNITURE
  BUILDING
  IT
  OTHER
}

enum AssetStatus {
  ACTIVE // in service, depreciating
  FULLY_DEPRECIATED // book value at residual
  DISPOSED // sold / written off
}

// Service Management (M22) — workshop / vehicle service orders.
enum ServiceOrderStatus {
  OPEN // logged, not started
  IN_PROGRESS // work underway (parts issued, labor added)
  COMPLETED // work finished, ready to post costs
  POSTED // labor cost posted to the ledger; order closed
  CANCELLED
}

// Where the work is done — own workshop vs an external vendor garage.
enum ServiceKind {
  INTERNAL // own mechanics; labor is a memo cost (already in payroll)
  EXTERNAL // outside garage; labor accrues to the ledger
}

// ── Human Resources (M24) ──
enum EmploymentType {
  PERMANENT // open-ended contract
  FIXED_TERM // fixed end date
  PROBATION // probationary period
  CONTRACTOR // service contract, not an employee
}

enum ContractStatus {
  DRAFT // not yet in force
  ACTIVE // currently in force (at most one per employee)
  ENDED // superseded, expired, or terminated
}

enum LeaveType {
  ANNUAL // paid annual leave (accrues a balance)
  SICK // paid sick leave (accrues a balance)
  UNPAID // leave without pay (no balance)
  MATERNITY
  COMPASSIONATE
}

enum LeaveStatus {
  PENDING // submitted, awaiting approval
  APPROVED // approved; balance deducted
  REJECTED
  CANCELLED // withdrawn before/after approval
}

enum EmployeeDocType {
  CONTRACT
  NATIONAL_ID
  PASSPORT
  WORK_PERMIT
  CERTIFICATE
  OTHER
}

// ── Time & Attendance (M26) ──
// Source of a clock record. BIOMETRIC is integration-gated on a terminal feed
// (PRD §5); until wired, entries are MANUAL or from the mobile app.
enum AttendanceSource {
  MANUAL
  MOBILE
  BIOMETRIC
}

enum TimesheetStatus {
  OPEN // accruing entries for the period
  SUBMITTED // sent for approval; entries locked
  APPROVED // approved; overtime available to payroll
  REJECTED
}

// ── Operational KPI capture (client dashboard spec, Tier C internal) ──
// Dock/yard arrival & departure, so truck-turnaround time can be computed.
enum DockEventKind {
  ARRIVAL
  DEPARTURE
}

// Cargo damage / loss claim lifecycle, for the damage & claim-rate KPI.
enum DamageStatus {
  REPORTED
  UNDER_REVIEW
  APPROVED // claim accepted
  REJECTED
  SETTLED
}

// ───────────────────────── Sales & Marketing (M27) ─────────────────────────

// A sales lead in the CRM pipeline (the "marketing" half of M27).
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON // converted to a client / quote
  LOST
}

// A freight quotation's lifecycle. ACCEPTED quotes can be converted into a
// freight Order (M12); once converted the quote is locked as CONVERTED.
enum QuoteStatus {
  DRAFT
  SENT // issued to the client, awaiting decision
  ACCEPTED
  REJECTED
  EXPIRED // past validUntil with no decision
  CONVERTED // turned into a freight Order
}

// ───────────────────────── Project Management (M29) ─────────────────────────

// A project / long-haul contract grouping several freight orders, tracked
// against a planned budget.
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// ───────────────────────── Master Planning (M33) ─────────────────────────

// A demand forecast's lifecycle. Planners draft a forecast, confirm it into the
// plan, then archive it once the period has passed.
enum ForecastStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

// ───────────────────────── Retail / POS (M28) ─────────────────────────

// A point-of-sale transaction's lifecycle. Completing it relieves inventory and
// posts revenue + COGS to the ledger; a completed sale can only be VOIDed.
enum PosSaleStatus {
  DRAFT
  COMPLETED
  VOID
}

enum PosPaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

// ───────────────────────── Multi-company (M34) ─────────────────────────

// A legal entity / tenant. Its `code` is the `dataAreaId` used to partition every
// business record; the code is validated against this registry on write. Kept as
// a lightweight registry (no DB-level FK from every table) so partitioning stays a
// simple, indexable string across the ~30 partitioned models.
/**
 * Tenant boundary (parent company). An Organization owns a group of legal
 * entities; two organizations on the same database must never see each other,
 * and each has its own ADMIN. Only SUPER_ADMIN sees across organizations.
 *
 * Isolation is still carried by `dataAreaId` on every business record — the
 * organization simply decides *which* dataAreaIds a user may reach, resolved in
 * `lib/scope.ts`. No business table changes.
 */
model Organization {
  id       String  @id @default(cuid())
  code     String  @unique // short key, e.g. "ACME"
  name     String
  isActive Boolean @default(true)

  companies Company[]

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizations")
}

model Company {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String        @unique // = dataAreaId (e.g. HQ01, KE01)
  name           String
  baseCurrency   String        @default("USD")
  country        String        @default("TZ") // ISO country
  isActive       Boolean       @default(true)
  isSandbox      Boolean       @default(false) // demo/sandbox partition — safe to reset (M32)
  // Sandbox access window: after this instant every login into the partition is
  // refused. Null = no expiry. Only meaningful when `isSandbox`.
  sandboxExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  version     Int     @default(0)
  createdById String?
  updatedById String?

  @@index([organizationId])
  @@map("companies")
}

// ───────────────────────── Auth / User ─────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              Role      @default(STAFF) // system role (drives ADMIN/DRIVER special behavior + JWT)
  roleKey           String? // optional custom role (RbacRole.key); when set, its grants replace the system-role defaults for permission checks
  customRole        RbacRole? @relation(fields: [roleKey], references: [key], onDelete: SetNull)
  dataAreaId        String    @default("HQ01") // legal entity the user belongs to (multi-company isolation, PRD §6.2)
  isActive          Boolean   @default(true)
  // Throwaway login generated for a sandbox partition (M32). Flagged so a sandbox
  // wipe can delete exactly these and never a real account.
  isDemo            Boolean   @default(false)
  emailVerified     DateTime?
  image             String?
  resetToken        String?   @unique
  resetTokenExpires DateTime?

  // ── Profile & operations (spec: Users §1–2) ──
  phone          String?
  jobTitle       String? // Dispatcher / Fleet Manager / Accountant …
  assignedBranch String? // physical terminal / hub

  // ── Financial & audit access (spec: Users §4) ──
  costCenter    String?
  approvalLimit Decimal? @db.Decimal(18, 2) // max freight/procurement approval
  esignatory    Boolean  @default(false) // can sign freight bills / LRs / PODs

  // ── System (spec: Users §3, §5) ──
  languagePref String?
  timeZone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 — a DRIVER user is linked to a Driver record
  driver           Driver?
  notifications    Notification[]
  activityLogs     ActivityLog[]
  dispatches       Dispatch[]        @relation("DispatchCreatedBy")
  journalEntries   JournalEntry[]    @relation("JournalCreatedBy")
  orders           Order[]           @relation("OrderCreatedBy")
  trips            Trip[]            @relation("TripCreatedBy")
  vendorInvoices   VendorInvoice[]   @relation("VendorInvoiceCreatedBy")
  customerInvoices CustomerInvoice[] @relation("CustomerInvoiceCreatedBy")
  moneyTransfers   MoneyTransfer[]   @relation("MoneyTransferCreatedBy")
  budgets          Budget[]          @relation("BudgetCreatedBy")
  leads            Lead[]            @relation("LeadOwner")

  @@index([role])
  @@index([dataAreaId])
  @@index([isDemo, dataAreaId])
  @@map("users")
}

// ───────────────────────── Driver ─────────────────────────

model Driver {
  id           String       @id @default(cuid())
  dataAreaId   String       @default("HQ01") // legal entity (multi-company isolation)
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String       @unique
  phone        String
  address      String
  contractType ContractType @default(CONTRACTOR)
  joinedAt     DateTime
  status       DriverStatus @default(ACTIVE)

  // ── Identity & contact (spec: Driver §1) ──
  dateOfBirth      DateTime? @db.Date
  gender           String?
  altPhone         String?
  homeTerminal     String? // default depot the driver operates from
  emergencyContact String? // name · relationship · phone

  // ── Qualifications & certifications (spec: Driver §2) ──
  licenseNumber     String? // CDL / local equivalent
  licenseClass      String? // class / endorsements (Hazmat, Tanker)
  licenseExpiry     DateTime? @db.Date
  medicalCertExpiry DateTime? @db.Date
  passportNumber    String?
  passportExpiry    DateTime? @db.Date

  // ── Employment & payroll config (spec: Driver §3) ──
  driverType      DriverType @default(COMPANY)
  terminationDate DateTime?  @db.Date
  payScale        String? // per-mile (loaded/empty) / hourly / % of load
  taxId           String? // SSN / TIN

  // ── HOS & telematics (spec: Driver §4–5) ──
  eldId               String? // ELD / telematics hardware ID
  hosCycleRule        String? // e.g. "70h/8-day"
  terminalTimeZone    String?
  assignedVehicle     String? // primary tractor / vehicle ref
  cargoQualifications String? // trailer / cargo types certified
  languagePref        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability      DriverAvailability[]
  holidays          Holiday[]
  dispatches        Dispatch[]
  dailyReports      DailyReport[]
  payments          Payment[]
  trips             Trip[]
  secondDriverTrips Trip[]               @relation("TripSecondDriver")
  defaultForVehicles Vehicle[]           @relation("VehicleDefaultDriver")
  transfers         MoneyTransfer[]
  documents         DriverDocument[]
  employee          Employee?
  expenseClaims     ExpenseClaim[]
  version           Int                  @default(0) // optimistic concurrency (PRD §7.1)
  createdById       String? // audit: creator user id
  updatedById       String? // audit: last-modifier user id

  @@index([status])
  @@index([dataAreaId])
  @@map("drivers")
}

// 稼働設定 (per weekday working hours)
model DriverAvailability {
  id          String   @id @default(cuid())
  dataAreaId  String   @default("HQ01") // legal entity (multi-company isolation)
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday .. 6 = Saturday
  startTime   String // "HH:mm"
  endTime     String // "HH:mm"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@unique([driverId, weekday])
  @@index([dataAreaId])
  @@map("driver_availabilities")
}

// 休日管理
model Holiday {
  id          String   @id @default(cuid())
  dataAreaId  String   @default("HQ01") // legal entity (multi-company isolation)
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now())
  version     Int      @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@unique([driverId, date])
  @@index([date])
  @@index([dataAreaId])
  @@map("holidays")
}

// ───────────────────────── Vehicle ─────────────────────────

model Vehicle {
  id               String        @id @default(cuid())
  dataAreaId       String        @default("HQ01") // legal entity (multi-company isolation)
  vehicleNumber    String        @unique // 社内管理番号
  plateNumber      String        @unique // ナンバープレート
  maker            String
  model            String
  insuranceExpiry  DateTime      @db.Date
  inspectionExpiry DateTime      @db.Date // 車検満了
  status           VehicleStatus @default(AVAILABLE)

  // ── Identification & specs (spec: Vehicles §1) ──
  vin         String? // VIN / chassis number
  yearMade    Int?
  vehicleType String? // Flatbed / Tanker / Box Van / Reefer
  bodyType    String? // rigid / articulated tractor / trailer

  // ── Physical & technical (spec: Vehicles §2) ──
  tareWeightKg     Decimal? @db.Decimal(12, 2)
  gvwKg            Decimal? @db.Decimal(12, 2) // gross vehicle weight
  payloadKg        Decimal? @db.Decimal(12, 2)
  loadingVolumeCbm Decimal? @db.Decimal(12, 2)
  dimensions       String? // L×W×H
  axleCount        Int?
  suspensionType   String?

  // ── Compliance & licensing (spec: Vehicles §3) ──
  registrationExpiry DateTime? @db.Date
  insurancePolicyNo  String?
  emissionRating     String? // Euro IV / Euro VI
  operatingPermit    String? // LATRA etc.
  // M11 cross-border compliance (PRD §4.2). Optional so existing rows stay valid.
  comesaPermitExpiry DateTime? @db.Date // COMESA transit permit
  yellowCardExpiry   DateTime? @db.Date // Yellow Card insurance (cross-border)

  // ── Operations & telematics (spec: Vehicles §4) ──
  ownershipStatus OwnershipStatus @default(OWNED)
  transporterName String? // third-party provider (leased/subcontracted)
  fuelType        FuelType?
  fuelCardNumber  String?
  telematicsId    String? // GPS device ID
  homeTerminal    String?
  assignedDriver  String? // free-text note kept from the original spec
  // The driver normally paired with this truck. Pre-fills the trip form when the
  // vehicle is picked, so dispatch confirms rather than retypes (client review).
  defaultDriverId String?
  defaultDriver   Driver? @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)

  // ── Maintenance & workshop (spec: Vehicles §5) ──
  odometerKm      Int?
  engineNumber    String?
  tyreSize        String?
  batterySpec     String?
  lastServiceDate DateTime? @db.Date
  lastServiceKm   Int?

  // ── Financial & asset (spec: Vehicles §6) ──
  assetAccountCode   String? // links to fixed-asset / GL
  purchaseDate       DateTime? @db.Date
  purchasePrice      Decimal?  @db.Decimal(18, 2)
  depreciationMethod String? // straight-line / declining balance
  // Fuel-efficiency target: km per litre when loaded, for siphoning/efficiency checks.
  fuelTargetKmPerL   Decimal?  @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances  VehicleMaintenance[]
  serviceOrders ServiceOrder[]
  dispatches    Dispatch[]
  trips         Trip[]
  position      VehiclePosition?
  dockEvents    DockEvent[]
  version       Int                  @default(0) // optimistic concurrency (PRD §7.1)
  createdById   String? // audit: creator user id
  updatedById   String? // audit: last-modifier user id

  @@index([defaultDriverId])
  @@index([status])
  @@index([dataAreaId])
  @@map("vehicles")
}

model VehicleMaintenance {
  id              String   @id @default(cuid())
  dataAreaId      String   @default("HQ01") // legal entity (multi-company isolation)
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceType String // 整備種別 (オイル交換, 車検, タイヤ など)
  date            DateTime @db.Date
  cost            Int // 円
  note            String?
  createdAt       DateTime @default(now())
  version         Int      @default(0) // optimistic concurrency (PRD §7.1)
  createdById     String? // audit: creator user id
  updatedById     String? // audit: last-modifier user id

  @@index([vehicleId])
  @@index([dataAreaId])
  @@map("vehicle_maintenances")
}

// ───────────────────────── Client (荷主) ─────────────────────────

model Client {
  id            String @id @default(cuid())
  dataAreaId    String @default("HQ01") // legal entity (multi-company isolation)
  companyName   String
  contactPerson String
  phone         String
  address       String
  email         String

  // ── General & contact (spec: Client §1) ──
  tradeName String? // DBA
  industry  String? // 3PL / Retail / Manufacturing / Wholesaler
  status    PartyStatus @default(ACTIVE)
  website   String?

  // ── Billing & financial (spec: Client §2) ──
  tin         String?
  currency    String      @default("USD")
  paymentTerm PaymentTerm @default(NET_30)
  creditLimit Decimal     @default(0) @db.Decimal(18, 2)
  taxExempt   Boolean     @default(false)

  // ── Freight profile (spec: Client §3) ──
  shippingPreferences String? // LTL / FTL / Air / Ocean / Intermodal
  preferredCarriers   String?
  hazmatCertified     Boolean @default(false)

  // ── Compliance & integration (spec: Client §5–6) ──
  insuranceRequirement String? // minimum cargo value limits
  slaExpiry            DateTime? @db.Date
  accountManager       String? // sales rep / account owner

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs        DeliveryJob[]
  orders      Order[]
  quotes      SalesQuote[]
  projects    Project[]
  version     Int           @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@index([companyName])
  @@index([dataAreaId])
  @@map("clients")
}

// ───────────────────────── DeliveryJob (配送案件) ─────────────────────────

model DeliveryJob {
  id               String    @id @default(cuid())
  dataAreaId       String    @default("HQ01") // legal entity (multi-company isolation)
  jobCode          String    @unique
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pickupAddress    String
  deliveryAddress  String
  deliveryDate     DateTime
  cargoDescription String
  rewardAmount     Int // 報酬 (円)
  note             String?
  status           JobStatus @default(PENDING)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dispatch    Dispatch?
  dailyReport DailyReport?
  version     Int          @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@index([status])
  @@index([deliveryDate])
  @@index([clientId])
  @@index([dataAreaId])
  @@map("delivery_jobs")
}

// ───────────────────────── Dispatch (配車) ─────────────────────────

model Dispatch {
  id             String         @id @default(cuid())
  dataAreaId     String         @default("HQ01") // legal entity (multi-company isolation)
  jobId          String         @unique
  job            DeliveryJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         DispatchStatus @default(SCHEDULED)
  createdById    String?
  createdBy      User?          @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  version        Int            @default(0) // optimistic concurrency (PRD §7.1)
  updatedById    String? // audit: last-modifier user id

  @@index([driverId, scheduledStart])
  @@index([vehicleId, scheduledStart])
  @@index([dataAreaId])
  @@map("dispatches")
}

// ───────────────────────── DailyReport (日報) ─────────────────────────

model DailyReport {
  id            String      @id @default(cuid())
  dataAreaId    String      @default("HQ01") // legal entity (multi-company isolation)
  jobId         String      @unique
  job           DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  workStart     DateTime
  workEnd       DateTime
  mileage       Int // km
  note          String?
  proofImageUrl String? // 配送完了証跡
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([driverId])
  @@index([dataAreaId])
  @@map("daily_reports")
}

// ───────────────────────── Payment (報酬) ─────────────────────────

model Payment {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  year        Int
  month       Int // 1-12
  totalAmount Int // 集計報酬 (円)
  jobCount    Int
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([driverId, year, month])
  @@map("payments")
}

// ───────────────────────── Notification ─────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ───────────────────────── ActivityLog (監査ログ) ─────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE / UPDATE / DELETE / LOGIN ...
  target    String // "Driver:abc123"
  detail    String? // JSON string of changes
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ───────────────────────── Account (勘定科目) ─────────────────────────

// Chart of accounts. `code` is the human-facing account number (e.g. "1000").
// `dataAreaId` carries the legal-entity partition (PRD §7) so a single ledger
// table can serve multiple companies without re-migrating later.
model Account {
  id         String      @id @default(cuid())
  dataAreaId String      @default("HQ01") // legal entity (TZ01, KE01, HQ01 …)
  code       String
  name       String
  type       AccountType
  parentId   String?
  parent     Account?    @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Account[]   @relation("AccountTree")
  isActive   Boolean     @default(true)

  // ── Classification & posting behaviour (spec: COA §1, §4) ──
  subType            AccountSubType @default(NONE)
  postingType        PostingType    @default(POSTABLE)
  currency           String? // operational currency (null = entity base)
  defaultTaxCode     String? // default tax code applied on postings
  reconciliation     Boolean        @default(false) // AR/AP control — blocks manual postings
  allowManualPosting Boolean        @default(true)
  budgetingAllowed   Boolean        @default(false)

  // ── Transport dimensions (spec: COA §2) ──
  fleetSegment  String? // vehicle / fleet classification tag
  routeCorridor String? // shipping lane / corridor tag
  costCenter    String? // profit / cost center (Long-Haul, Last-Mile …)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       JournalLine[]
  version     Int           @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@unique([dataAreaId, code])
  @@index([type])
  @@map("accounts")
}

// ───────────────────────── JournalEntry (仕訳伝票) ─────────────────────────

// A balanced double-entry voucher. Once POSTED it is immutable; a correction is
// a new entry that REVERSES it (see `reversalOfId`).
model JournalEntry {
  id            String        @id @default(cuid())
  dataAreaId    String        @default("HQ01")
  voucherNumber String
  postingDate   DateTime      @db.Date
  currency      String        @default("USD") // ISO 4217 (USD, TZS, KES …)
  exchangeRate  Decimal       @default(1) @db.Decimal(18, 6) // to base currency, recorded per posting
  memo          String?
  status        JournalStatus @default(DRAFT)

  // ── Document header (spec: Journal §1) ──
  docType      JournalDocType @default(GENERAL)
  documentDate DateTime?      @db.Date // date the transaction actually occurred
  referenceNo  String? // external ref: B/L, CMR waybill, vendor invoice

  // Correction trail: a REVERSED entry points back to the entry it cancels.
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy   JournalEntry? @relation("Reversal")

  postedAt    DateTime?
  createdById String?
  createdBy   User?     @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines JournalLine[]

  // Reverse links from freight settlements (a posting may settle an order or expense).
  orderInvoice           Order?             @relation("OrderInvoice")
  tripExpense            TripExpense?       @relation("TripExpenseEntry")
  // AP / AR settlement links.
  vendorInvoicePosting   VendorInvoice?     @relation("VendorInvoicePosting")
  vendorPayment          VendorPayment?     @relation("VendorPaymentEntry")
  customerInvoicePosting CustomerInvoice?   @relation("CustomerInvoicePosting")
  customerReceipt        CustomerReceipt?   @relation("CustomerReceiptEntry")
  moneyTransfer          MoneyTransfer?     @relation("MoneyTransferEntry")
  stockMovement          StockMovement?     @relation("StockMovementPosting")
  payRun                 PayRun?            @relation("PayRunPosting")
  expenseClaim           ExpenseClaim?      @relation("ExpenseClaimPosting")
  depreciationEntry      DepreciationEntry? @relation("DepreciationPosting")
  assetDisposal          FixedAsset?        @relation("AssetDisposalPosting")
  serviceOrder           ServiceOrder?      @relation("ServiceOrderPosting")
  posRevenue             PosSale?           @relation("PosRevenue")
  posCogs                PosSale?           @relation("PosCogs")
  version                Int                @default(0) // optimistic concurrency (PRD §7.1)
  updatedById            String? // audit: last-modifier user id

  @@unique([dataAreaId, voucherNumber])
  @@index([status])
  @@index([postingDate])
  @@map("journal_entries")
}

// One side of a posting. Exactly one of debit/credit is non-zero per line, and
// SUM(debit) == SUM(credit) across an entry (enforced in services/ledger.ts).
model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Decimal      @default(0) @db.Decimal(18, 2)
  credit    Decimal      @default(0) @db.Decimal(18, 2)
  memo      String?
  // Free-form dimension for branch / cost-object tagging (PRD M8 dimensions).
  dimension String?

  // ── Line-item detail & operational dimensions (spec: Journal §2, §3) ──
  taxCode     String? // VAT / sales-tax code for the line
  openItemRef String? // matching ref (invoice ↔ receipt)
  vehicleTag  String? // vehicle / fleet ID for per-asset profitability
  routeTag    String? // route / corridor ID for per-lane margins
  costCenter  String? // terminal / depot / business unit
  driverTag   String? // driver ID (per-diems, fines)
  partyTag    String? // customer / vendor / subcontractor code
  tripTag     String? // trip / haulage-contract number

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ───────────────────────── Order (受注 / Freight Booking) ─────────────────────────

// A cross-border freight order/booking (PRD M2 billing + M12 load). Revenue side
// of the business; settled to the ledger as an AR invoice when INVOICED.
model Order {
  id               String       @id @default(cuid())
  dataAreaId       String       @default("HQ01")
  orderCode        String       @unique
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  originZone       String // e.g. "Dar es Salaam Port"
  destinationZone  String // e.g. "Kigali Depot"
  corridor         CorridorType @default(DOMESTIC)
  cargoDescription String
  grossWeightKg    Decimal      @default(0) @db.Decimal(12, 2)
  volumeCbm        Decimal      @default(0) @db.Decimal(12, 2)
  freightAmount    Decimal      @db.Decimal(18, 2) // quoted/agreed revenue
  demurrageAmount  Decimal      @default(0) @db.Decimal(18, 2)
  currency         String       @default("USD")
  bookingDate      DateTime     @db.Date
  status           OrderStatus  @default(DRAFT)

  // ── Organizational (spec: Orders §1) ──
  branch      String? // operating office handling the job
  salesperson String? // account manager credited with the sale
  incoterms   String? // FOB / CIF / EXW
  paymentTerm PaymentTerm @default(NET_30)

  // ── Parties (spec: Orders §2) ──
  shipper     String? // consignor — sends the goods
  consignee   String? // receives the goods
  billTo      String? // pays the freight invoice
  notifyParty String? // notified on arrival / status change

  // ── Routing (spec: Orders §3) ──
  pickupAddress   String?
  deliveryAddress String?
  pol             String? // port of loading
  pod             String? // port of delivery
  etd             DateTime? // estimated departure
  eta             DateTime? // estimated arrival
  routingNotes    String?

  // ── Cargo & equipment (spec: Orders §4) ──
  equipmentType EquipmentType @default(OTHER)
  pieceCount    Int? // pallets / boxes / parcels
  dimensions    String? // L×W×H
  hazmat        Boolean       @default(false)
  hazmatUnCode  String? // UN number / class / packing group

  // ── Financial (spec: Orders §5) ──
  freightRate        Decimal? @db.Decimal(18, 2) // agreed per-unit rate
  accessorialCharges Decimal  @default(0) @db.Decimal(18, 2) // detention, tarping, liftgate…
  taxAmount          Decimal  @default(0) @db.Decimal(18, 2)

  // ── Documentation (spec: Orders §6) ──
  customerPo          String? // client's PO number
  blNumber            String? // Master/House B/L or AWB
  hsCode              String? // Harmonized System / customs tariff
  sealNumber          String?
  specialInstructions String?

  // Ledger link: the AR invoice journal entry created on invoicing.
  invoiceEntryId String?       @unique
  invoiceEntry   JournalEntry? @relation("OrderInvoice", fields: [invoiceEntryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // One order is dispatched across as many trucks as the load needs — a large
  // consignment routinely takes 10 to 15 (client review). Each Trip is one
  // vehicle + driver leg of the same order.
  trips              Trip[]
  damageReports      DamageReport[]
  feedback           CustomerFeedback[]
  convertedFromQuote SalesQuote?        @relation("QuoteConvertedOrder")
  version            Int                @default(0) // optimistic concurrency (PRD §7.1)
  updatedById        String? // audit: last-modifier user id

  @@index([status])
  @@index([clientId])
  @@index([bookingDate])
  @@index([projectId])
  @@map("orders")
}

// ───────────────────────── Trip (運行 / Execution) ─────────────────────────

// Execution of an order by a driver+vehicle over a route. Holds the operational
// expenses whose sum feeds Trip P&L = order revenue − trip expenses.
model Trip {
  id             String       @id @default(cuid())
  dataAreaId     String       @default("HQ01")
  tripCode       String       @unique
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  corridor       CorridorType @default(DOMESTIC)
  mileageKm      Decimal      @default(0) @db.Decimal(12, 2)
  transitHours   Decimal      @default(0) @db.Decimal(10, 2)
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         TripStatus   @default(PLANNED)

  // ── Vehicle & crew (spec: Trips §1) ──
  trailerId      String? // connected trailer / container number
  secondDriverId String? // Driver 2
  secondDriver   Driver?   @relation("TripSecondDriver", fields: [secondDriverId], references: [id], onDelete: SetNull)
  actualStart    DateTime?
  actualEnd      DateTime?

  // ── Route (spec: Trips §2) ──
  originFacility      String?
  destinationFacility String?
  viaPoints           String? // transit hubs / border crossings
  plannedDistanceKm   Decimal? @db.Decimal(12, 2)
  routeCode           String? // pre-defined route template

  // ── Freight (spec: Trips §3) ──
  waybillNumber   String?
  cargoWeightKg   Decimal? @db.Decimal(12, 2)
  packageCount    Int?
  specialHandling String? // Hazmat / Refrigerated / Oversized

  // ── Financials (spec: Trips §4) ──
  advancePayment Decimal @default(0) @db.Decimal(18, 2) // cash / fuel card to driver
  driverWages    Decimal @default(0) @db.Decimal(18, 2) // fixed / per-diem / commission
  tollPermitCost Decimal @default(0) @db.Decimal(18, 2)
  miscExpense    Decimal @default(0) @db.Decimal(18, 2)

  // ── Fuel management (spec: Trips §5) ──
  fuelType       String? // Diesel …
  fuelCardNumber String?
  refuelStations String? // pre-approved stops

  // M11 fuel efficiency: actual litres consumed → actual km/L vs vehicle target.
  fuelLitres Decimal? @db.Decimal(10, 2)

  // ── Compliance & safety (spec: Trips §6) ──
  ewayBillRef   String? // e-way bill / customs reference
  podStatus     Boolean @default(false) // proof-of-delivery uploaded
  podUrl        String?
  sealNumbers   String?
  incidentNotes String? // breakdowns, accidents, delays

  // M12 freight-bill reconciliation against the carrier invoice.
  reconStatus       ReconStatus @default(UNRECONCILED)
  carrierInvoiceRef String?

  createdById String?
  createdBy   User?    @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses      TripExpense[]
  dockEvents    DockEvent[]
  damageReports DamageReport[]
  version       Int            @default(0) // optimistic concurrency (PRD §7.1)
  updatedById   String? // audit: last-modifier user id

  @@index([driverId, scheduledStart])
  @@index([vehicleId, scheduledStart])
  @@index([orderId])
  @@index([status])
  @@index([reconStatus])
  @@map("trips")
}

// A single operational cost on a trip. When posted, references its journal entry.
model TripExpense {
  id       String          @id @default(cuid())
  tripId   String
  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type     TripExpenseType
  amount   Decimal         @db.Decimal(18, 2)
  currency String          @default("USD")
  note     String?

  // Ledger link: the expense journal entry created when this cost is posted.
  entryId String?       @unique
  entry   JournalEntry? @relation("TripExpenseEntry", fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("trip_expenses")
}

// ───────────────────────── Vendor (M1 — Accounts Payable) ─────────────────────────

model Vendor {
  id          String      @id @default(cuid())
  dataAreaId  String      @default("HQ01")
  code        String // AP-VND-001
  legalName   String
  group       VendorGroup @default(OTHER)
  tin         String? // tax identification number (country-validated)
  vrn         String? // VAT registration number
  paymentTerm PaymentTerm @default(NET_30)
  currency    String      @default("USD")
  email       String?
  phone       String?
  isActive    Boolean     @default(true)

  // ── General & organizational (spec: Vendor §1) ──
  operatingName String? // DBA / trading name
  searchTerm    String? // alias / short code for lookup
  parentCompany String? // holding company for spend roll-ups

  // ── Contact & compliance (spec: Vendor §2) ──
  address         String?
  branchAddress   String?
  contactPerson   String?
  billingContact  String?
  insurancePolicy String? // carrier liability / cargo / WC policy no.
  insuranceExpiry DateTime? @db.Date // triggers a dispatch block when passed
  licenseNumber   String? // operating authority / hazmat certification

  // ── Financial (spec: Vendor §3) ──
  paymentMethod PaymentMethod? // EFT / wire / cheque / mobile money / fuel card
  bankName      String?
  bankSwift     String?
  bankIban      String?
  mobileMoney   String?
  reconAccount  String? // COA control account this vendor's sub-ledger maps to (2000)

  // ── Transport / TMS (spec: Vendor §4) ──
  scacCode       String? // Standard Carrier Alpha Code
  mcDotNumber    String? // MC / DOT regulatory number
  equipmentTypes String? // e.g. "Flatbed, Reefer, Tanker"
  fleetSize      Int? // trucks/trailers available
  rateAgreement  String? // default rates / FSC formula / lane pricing note
  ediEndpoint    String? // EDI profile / webhook URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices       VendorInvoice[]
  purchaseOrders PurchaseOrder[]
  serviceOrders  ServiceOrder[]
  version        Int             @default(0) // optimistic concurrency (PRD §7.1)
  createdById    String? // audit: creator user id
  updatedById    String? // audit: last-modifier user id

  @@unique([dataAreaId, code])
  @@index([group])
  @@index([insuranceExpiry])
  @@map("vendors")
}

// AP bill. Posted to the ledger as Dr <expense/asset> + Dr VAT recoverable
// / Cr Accounts Payable (2000) − Cr Withholding Tax Payable (2110).
model VendorInvoice {
  id            String        @id @default(cuid())
  dataAreaId    String        @default("HQ01")
  invoiceNumber String // vendor's invoice no (unique per vendor)
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  invoiceDate   DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  currency      String        @default("USD")
  subtotal      Decimal       @db.Decimal(18, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(18, 2)
  whtAmount     Decimal       @default(0) @db.Decimal(18, 2) // withholding tax
  total         Decimal       @db.Decimal(18, 2) // subtotal + vat − wht (net payable)
  paidAmount    Decimal       @default(0) @db.Decimal(18, 2)
  expenseCode   String        @default("6100") // COA expense account this bill hits
  memo          String?
  status        InvoiceStatus @default(DRAFT)

  // Ledger links
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("VendorInvoicePosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("VendorInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments       VendorPayment[]
  purchaseOrders PurchaseOrder[] @relation("PoVendorInvoice")
  version        Int             @default(0) // optimistic concurrency (PRD §7.1)
  updatedById    String? // audit: last-modifier user id

  @@unique([vendorId, invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@map("vendor_invoices")
}

// A settlement against an AP bill: Dr Accounts Payable / Cr Bank.
model VendorPayment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(18, 2)
  paidAt    DateTime      @db.Date
  bankCode  String        @default("1010") // COA bank/cash account credited
  reference String?

  entryId String?       @unique
  entry   JournalEntry? @relation("VendorPaymentEntry", fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("vendor_payments")
}

// ───────────────────────── Customer (M2 — Accounts Receivable) ─────────────────────────

model Customer {
  id          String  @id @default(cuid())
  dataAreaId  String  @default("HQ01")
  code        String // AR-CST-001
  name        String
  tin         String?
  creditLimit Decimal @default(0) @db.Decimal(18, 2)
  creditDays  Int     @default(30)
  taxExempt   Boolean @default(false) // diplomatic / transit
  currency    String  @default("USD")
  email       String?
  phone       String?
  isActive    Boolean @default(true)

  // ── General (spec: Customer §1) ──
  accountGroup   CustomerAccountGroup @default(SOLD_TO)
  industry       String?
  registrationNo String?
  searchTerm     String?

  // ── Address & geocoding (spec: Customer §2) ──
  billingAddress String?
  city           String?
  country        String?  @default("TZ")
  postalCode     String?
  latitude       Decimal? @db.Decimal(10, 6)
  longitude      Decimal? @db.Decimal(10, 6)
  transportZone  String? // route-optimization grouping
  timeZone       String?

  // ── Contact (spec: Customer §3) ──
  contactPerson String?
  apContact     String? // accounts-payable contact for billing

  // ── Freight profile (spec: Customer §4) ──
  shippingConditions String? // immediate / normal
  meansOfTransport   String? // flatbed / reefer / LTL / FTL
  dockRestrictions   String?
  hazmatCertified    Boolean @default(false)

  // ── Financial & operational (spec: Customer §5–6) ──
  incoterms         String? // FOB / CIF / EXW
  paymentTerm       PaymentTerm @default(NET_30)
  reconAccount      String? // AR control account (1100)
  preferredCarrier  String?
  communicationLang String? // language for waybills / invoices

  // ── Credit & collections (spec: Collections §1–3) ──
  accountStatus      PartyStatus  @default(ACTIVE)
  parentAccount      String? // master org for consolidated credit
  creditRating       String? // score / D&B rating (if available in region)
  tempCreditLimit    Decimal?     @db.Decimal(18, 2) // approved seasonal increase
  creditReviewDate   DateTime?    @db.Date
  creditHoldOverride Boolean      @default(false) // dispatcher can bill over the limit
  dunningLevel       DunningLevel @default(NONE)
  collectionStrategy String? // High-Risk / Standard Carrier …
  collectorId        String? // assigned AR specialist
  discountPercent    Decimal      @default(0) @db.Decimal(5, 2) // early-payment incentive
  discountDays       Int          @default(0)
  penaltyRate        Decimal      @default(0) @db.Decimal(5, 2) // overdue interest
  podRequired        Boolean      @default(false) // invoice valid for collection only with POD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices             CustomerInvoice[]
  collectionActivities CollectionActivity[]
  feedback             CustomerFeedback[]
  version              Int                  @default(0) // optimistic concurrency (PRD §7.1)
  createdById          String? // audit: creator user id
  updatedById          String? // audit: last-modifier user id

  @@unique([dataAreaId, code])
  @@index([name])
  @@map("customers")
}

// AR invoice. Posted as Dr Accounts Receivable (1100)
// / Cr <revenue> + Cr VAT Payable (2100).
model CustomerInvoice {
  id            String        @id @default(cuid())
  dataAreaId    String        @default("HQ01")
  invoiceNumber String // system AR no (AR-INV-000001)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate   DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  currency      String        @default("USD")
  subtotal      Decimal       @db.Decimal(18, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(18, 2)
  revenueCode   String        @default("4000") // COA revenue account this invoice credits
  tripId        String? // optional link to a trip (demurrage / freight billing)
  memo          String?
  status        InvoiceStatus @default(DRAFT)

  // ── Collections lifecycle (spec: Collections §4) ──
  dunningLevel       DunningLevel  @default(NONE)
  disputeStatus      DisputeStatus @default(NONE)
  disputedAmount     Decimal       @default(0) @db.Decimal(18, 2)
  promiseToPayDate   DateTime?     @db.Date
  promiseToPayAmount Decimal?      @db.Decimal(18, 2)
  lastContactDate    DateTime?     @db.Date
  writeOffAmount     Decimal       @default(0) @db.Decimal(18, 2)

  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("CustomerInvoicePosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("CustomerInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  receipts             CustomerReceipt[]
  collectionActivities CollectionActivity[]
  version              Int                  @default(0) // optimistic concurrency (PRD §7.1)
  updatedById          String? // audit: last-modifier user id

  @@unique([dataAreaId, invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@index([disputeStatus])
  @@map("customer_invoices")
}

// A logged collection action — dunning, call, promise-to-pay, dispute, write-off,
// or a free-form note (spec: Collections §4). Attached to a customer, optionally to
// a specific invoice. Provides the dunning audit trail and the collector's notes.
model CollectionActivity {
  id         String           @id @default(cuid())
  dataAreaId String           @default("HQ01")
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    CustomerInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  type          CollectionActivityType
  activityDate  DateTime               @default(now())
  note          String?
  // Snapshot fields for the action taken (nullable per type).
  dunningLevel  DunningLevel?
  promiseDate   DateTime?              @db.Date
  promiseAmount Decimal?               @db.Decimal(18, 2)
  amount        Decimal?               @db.Decimal(18, 2) // disputed / written-off amount

  createdById String?
  createdAt   DateTime @default(now())

  @@index([dataAreaId])
  @@index([customerId])
  @@index([invoiceId])
  @@map("collection_activities")
}

// A receipt against an AR invoice: Dr Bank / Cr Accounts Receivable.
model CustomerReceipt {
  id         String          @id @default(cuid())
  invoiceId  String
  invoice    CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal         @db.Decimal(18, 2)
  receivedAt DateTime        @db.Date
  bankCode   String          @default("1010")
  reference  String?

  entryId String?       @unique
  entry   JournalEntry? @relation("CustomerReceiptEntry", fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("customer_receipts")
}

// ───────────────────────── Multi-currency (M8 / M5) ─────────────────────────

// A dated exchange rate from `currency` to `baseCurrency` for a given rate type.
// Lookups take the most recent rate on/before the posting date (PRD §7).
model ExchangeRate {
  id           String   @id @default(cuid())
  dataAreaId   String   @default("HQ01")
  currency     String // ISO 4217 of the foreign currency (TZS, KES …)
  baseCurrency String   @default("USD")
  rateType     RateType @default(SPOT)
  rate         Decimal  @db.Decimal(18, 6) // multiply foreign × rate → base
  validFrom    DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([dataAreaId, currency, baseCurrency, rateType, validFrom])
  @@index([dataAreaId, currency, rateType])
  @@map("exchange_rates")
}

// ───────────────────────── Cash & Bank (M4) ─────────────────────────

// A bank / mobile-money / cash account, linked to its GL control account (glCode).
model BankAccount {
  id         String          @id @default(cuid())
  dataAreaId String          @default("HQ01")
  code       String // internal code, e.g. BANK-CRDB-USD
  name       String // "CRDB — Main USD"
  type       BankAccountType @default(BANK)
  glCode     String // COA account this cash account maps to (1010, 1030 …)
  currency   String          @default("USD")
  iban       String?
  swift      String?
  provider   String? // Safaricom / Airtel / CRDB …
  accountNo  String? // bank account or mobile MSISDN
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  transfers   MoneyTransfer[]
  version     Int             @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@unique([dataAreaId, code])
  @@index([type])
  @@map("bank_accounts")
}

// A disbursement to a driver from a bank/mobile-money account. When SUCCESS it
// posts Dr <disbursement expense> / Cr <bank gl> and links the journal entry.
model MoneyTransfer {
  id            String           @id @default(cuid())
  dataAreaId    String           @default("HQ01")
  reference     String // internal reference / receipt no
  bankAccountId String
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  driverId      String?
  driver        Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  type          DisbursementType @default(OTHER)
  amount        Decimal          @db.Decimal(18, 2)
  currency      String           @default("USD")
  expenseCode   String           @default("5030") // COA expense debited (driver allowance default)
  externalRef   String? // M-Pesa/Airtel transaction id from the callback
  status        TransferStatus   @default(PENDING)
  transferredAt DateTime         @db.Date
  memo          String?

  // Ledger link: the disbursement journal entry, created when status → SUCCESS.
  entryId String?       @unique
  entry   JournalEntry? @relation("MoneyTransferEntry", fields: [entryId], references: [id], onDelete: SetNull)

  // Expense reconciliation (M23): the claim that settled this advance, if any.
  expenseClaim ExpenseClaim? @relation("ClaimAdvance")

  createdById String?
  createdBy   User?    @relation("MoneyTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(0) // optimistic concurrency (PRD §7.1)
  updatedById String? // audit: last-modifier user id

  @@index([bankAccountId])
  @@index([driverId])
  @@index([status])
  @@map("money_transfers")
}

// ───────────────────────── Budgeting (M3) ─────────────────────────

// A budget period (typically a fiscal year) per legal entity.
model Budget {
  id          String        @id @default(cuid())
  dataAreaId  String        @default("HQ01")
  name        String // "FY2026 Operating Budget"
  fiscalYear  Int
  control     BudgetControl @default(WARNING_ONLY)
  isActive    Boolean       @default(true)
  createdById String?
  createdBy   User?         @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines       BudgetLine[]
  version     Int          @default(0) // optimistic concurrency (PRD §7.1)
  updatedById String? // audit: last-modifier user id

  @@unique([dataAreaId, fiscalYear, name])
  @@index([fiscalYear])
  @@map("budgets")
}

// A budgeted amount for a cost center + GL account. `consumed` is updated in
// real time as financial postings hit the account (PRD M3).
model BudgetLine {
  id          String     @id @default(cuid())
  budgetId    String
  budget      Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  kind        BudgetKind @default(OPEX)
  costCenter  String // "Fleet Operations", "Workshop Mombasa"
  accountCode String // COA account this line governs
  amount      Decimal    @db.Decimal(18, 2) // budgeted ceiling
  consumed    Decimal    @default(0) @db.Decimal(18, 2) // posted-to-date
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([budgetId, costCenter, accountCode])
  @@index([budgetId])
  @@map("budget_lines")
}

// ───────────────────────── Consolidations (M5) ─────────────────────────

// Maps a subsidiary entity's account to a parent (HQ) ledger account, so a
// consolidation run can roll subsidiary balances up into the parent (PRD M5).
model ConsolidationMap {
  id            String   @id @default(cuid())
  parentArea    String   @default("HQ01") // consolidating entity
  subsidiary    String // source entity (TZ01, KE01 …)
  subAccount    String // account code in the subsidiary
  parentAccount String // account code in the parent
  createdAt     DateTime @default(now())

  @@unique([parentArea, subsidiary, subAccount])
  @@index([parentArea, subsidiary])
  @@map("consolidation_maps")
}

// ───────────────────────── Driver Documents (M11) ─────────────────────────

// A compliance document for a driver, with its own expiry. Drives the
// border-impound risk warnings on the compliance dashboard (PRD §2.2, §8.3).
model DriverDocument {
  id          String        @id @default(cuid())
  dataAreaId  String        @default("HQ01") // legal entity (multi-company isolation)
  driverId    String
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type        DriverDocType
  number      String? // document / certificate number
  issuedAt    DateTime?     @db.Date
  expiresAt   DateTime      @db.Date
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  version     Int           @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@unique([driverId, type])
  @@index([expiresAt])
  @@index([dataAreaId])
  @@map("driver_documents")
}

// ───────────────────────── GPS Waypoints (M30 Common) ─────────────────────────

// A named checkpoint on the corridors (Chalinze, Malaba, Namanga …) with
// coordinates. Master data for route planning and the border-turnaround tracker.
model GpsWaypoint {
  id         String  @id @default(cuid())
  dataAreaId String  @default("HQ01") // legal entity (multi-company isolation)
  code       String  @unique // CHALINZE, MALABA …
  name       String
  kind       String  @default("CHECKPOINT") // CHECKPOINT / BORDER / WEIGHBRIDGE / DEPOT
  lat        Decimal @db.Decimal(9, 6)
  lng        Decimal @db.Decimal(9, 6)
  country    String? // ISO country of the point
  isActive   Boolean @default(true)

  // ── Coordinate & facility (spec: GPS Waypoint §1–2) ──
  altitude       Decimal? @db.Decimal(9, 2) // metres above sea level
  locationType   String? // Hub / Warehouse / Port / Customer Site / Fuel Stop
  address        String?
  geofenceRadius Int? // metres
  timeZone       String?
  contactDetails String? // on-site manager / phone / hours

  // ── Operational rules (spec: GPS Waypoint §3) ──
  serviceTimeMin     Int? // standard loading/unloading window
  requiredEquipment  String? // Forklift / Reefer power …
  accessRestrictions String? // No night deliveries / weight limits
  sequenceNo         Int? // visit order on a multi-stop route

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(0) // optimistic concurrency (PRD §7.1)
  createdById String? // audit: creator user id
  updatedById String? // audit: last-modifier user id

  @@index([kind])
  @@index([dataAreaId])
  @@map("gps_waypoints")
}

// Units-of-measure registry (M30 Common). A per-company catalog of the units the
// business trades in — weight, volume, distance, count … Each unit records how
// many of its dimension's base unit it equals (`factorToBase`), which lets the
// system convert a quantity between any two units of the same dimension.
enum UomDimension {
  WEIGHT
  VOLUME
  LENGTH
  AREA
  COUNT
  TIME
}

model UnitOfMeasure {
  id           String       @id @default(cuid())
  dataAreaId   String       @default("HQ01") // legal entity (multi-company isolation)
  code         String // KG, TON, L, M3 … unique per company
  name         String // Kilogram, Metric Tonne …
  dimension    UomDimension @default(COUNT)
  symbol       String? // display symbol: kg, t, L
  factorToBase Decimal      @default(1) @db.Decimal(20, 8) // value of 1 unit expressed in the dimension's base unit
  isBase       Boolean      @default(false) // the canonical base unit of its dimension (factorToBase = 1)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([dataAreaId, code])
  @@index([dataAreaId])
  @@map("units_of_measure")
}

// Last-known position of a vehicle. One row per vehicle, updated by the tracking
// feed. `source` stays STUB until a telematics provider is wired up (PRD §5).
model VehiclePosition {
  id           String         @id @default(cuid())
  dataAreaId   String         @default("HQ01") // legal entity (multi-company isolation)
  vehicleId    String         @unique
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat          Decimal        @db.Decimal(9, 6)
  lng          Decimal        @db.Decimal(9, 6)
  speedKph     Decimal?       @db.Decimal(6, 2)
  headingDeg   Int?
  source       PositionSource @default(STUB)
  nearWaypoint String? // resolved nearest waypoint code, if any
  pingedAt     DateTime
  updatedAt    DateTime       @updatedAt

  @@index([dataAreaId])
  @@map("vehicle_positions")
}

// ───────────────────────── Inventory (M14) ─────────────────────────

model StockItem {
  id             String        @id @default(cuid())
  dataAreaId     String        @default("HQ01")
  code           String // internal SKU, e.g. SP-BRAKE-PAD
  name           String
  category       StockCategory @default(SPARE_PART)
  unit           StockUnit     @default(PIECE)
  glCode         String        @default("1300") // inventory asset account
  expenseCode    String        @default("5100") // account charged when issued (maintenance/fuel)
  quantityOnHand Decimal       @default(0) @db.Decimal(18, 3)
  avgCost        Decimal       @default(0) @db.Decimal(18, 4) // moving-average unit cost (base ccy)
  reorderLevel   Decimal       @default(0) @db.Decimal(18, 3)
  currency       String        @default("USD")
  isActive       Boolean       @default(true)

  // ── Identification & classification (spec: Inventory §1) ──
  oemPartNumber      String?
  supplierPartNumber String?

  // ── Fleet & maintenance (spec: Inventory §2) ──
  applicableFleet String? // vehicle make/model/fleet tag the part fits
  partCondition   String? // New / Rebuilt / Remanufactured / Used
  assetSerialNo   String? // for high-value components
  hazmat          Boolean @default(false)

  // ── Purchasing & financial (spec: Inventory §3) ──
  standardCost      Decimal? @db.Decimal(18, 4)
  lastPurchasePrice Decimal? @db.Decimal(18, 4)
  defaultVendor     String?
  taxCode           String?
  valuationMethod   String?  @default("AVERAGE") // AVERAGE / FIFO / LIFO

  // ── Warehousing & location (spec: Inventory §4) ──
  storageLocation String?
  binRack         String?
  batchLot        String?
  manufactureDate DateTime? @db.Date
  expiryDate      DateTime? @db.Date

  // ── Inventory control (spec: Inventory §5) ──
  maxStockLevel    Decimal? @db.Decimal(18, 3)
  safetyStock      Decimal? @db.Decimal(18, 3)
  leadTimeDays     Int?
  economicOrderQty Decimal? @db.Decimal(18, 3)

  // ── Warranty & quality (spec: Inventory §6) ──
  warrantyPeriod String? // duration or mileage/hours
  warrantyStart  DateTime? @db.Date
  qualityStatus  String? // Available / Quarantined / Awaiting Inspection

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    StockMovement[]
  poLines      PurchaseOrderLine[]
  balances     StockBalance[]
  serviceParts ServicePart[]
  posLines     PosSaleLine[]
  attributes   StockItemAttribute[]
  version      Int                  @default(0) // optimistic concurrency (PRD §7.1)
  createdById  String? // audit
  updatedById  String? // audit

  @@unique([dataAreaId, code])
  @@index([category])
  @@map("stock_items")
}

model StockMovement {
  id           String            @id @default(cuid())
  dataAreaId   String            @default("HQ01")
  stockItemId  String
  stockItem    StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Decimal           @db.Decimal(18, 3) // always positive; type gives direction
  unitCost     Decimal           @db.Decimal(18, 4) // cost per unit for this movement
  totalCost    Decimal           @db.Decimal(18, 2) // quantity × unitCost
  qtyAfter     Decimal           @db.Decimal(18, 3) // on-hand snapshot after this movement
  avgCostAfter Decimal           @db.Decimal(18, 4) // moving-average snapshot after this movement
  reference    String? // PO number, vehicle/trip ref, stock-take id
  memo         String?

  // Warehouse this movement affected (M18). Null = legacy/default location.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Ledger link — the journal entry this movement posted (if any).
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("StockMovementPosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  createdById String?

  @@index([stockItemId])
  @@index([type])
  @@index([warehouseId])
  @@map("stock_movements")
}

// ───────────────────────── Warehouse (M18) ─────────────────────────

model Warehouse {
  id         String  @id @default(cuid())
  dataAreaId String  @default("HQ01")
  code       String // e.g. WH-DAR, WH-MSA
  name       String
  location   String? // city / address
  isDefault  Boolean @default(false) // the MAIN warehouse receipts default to
  isActive   Boolean @default(true)

  // ── Identification (spec: Warehouses §1) ──
  facilityType FacilityType @default(DISTRIBUTION_CENTER)
  timeZone     String?

  // ── Location & geocoding (spec: Warehouses §2) ──
  address    String?
  city       String?
  country    String?  @default("TZ")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 6)
  longitude  Decimal? @db.Decimal(10, 6)

  // ── Contact (spec: Warehouses §3) ──
  managerName String?
  phone       String?
  email       String?

  // ── Dock & operations (spec: Warehouses §4) ──
  dockCapacity   Int?
  dockScheduling String? // appointment-based / open-arrival
  operatingHours String?

  // ── Capacity & control (spec: Warehouses §5–6) ──
  storageTypes    String? // Bulk / Rack / Cold / Hazmat
  capacityLimit   String? // max weight / volume / pallets
  putawayStrategy String? // fixed bin / empty bin / closest to dock
  pickingStrategy String? // FIFO / LIFO / partial pallet
  countMethod     String? // Annual / Cycle / Continuous

  balances  StockBalance[]
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  version     Int     @default(0) // optimistic concurrency (PRD §7.1)
  createdById String?
  updatedById String?

  @@unique([dataAreaId, code])
  @@map("warehouses")
}

model StockBalance {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(18, 3) // on-hand at this location
  updatedAt   DateTime  @updatedAt

  @@unique([stockItemId, warehouseId])
  @@index([warehouseId])
  @@map("stock_balances")
}

// ───────────────────────── Procurement (M15) ─────────────────────────

model PurchaseOrder {
  id          String              @id @default(cuid())
  dataAreaId  String              @default("HQ01")
  poNumber    String // internal, e.g. PO-000123
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      PurchaseOrderStatus @default(DRAFT)
  matchStatus MatchStatus         @default(UNMATCHED)
  currency    String              @default("USD")
  orderDate   DateTime            @db.Date
  expectedAt  DateTime?           @db.Date
  subtotal    Decimal             @default(0) @db.Decimal(18, 2) // Σ line totals
  memo        String?

  // 3-way match: the vendor bill this PO was matched against.
  vendorInvoiceId String?
  vendorInvoice   VendorInvoice? @relation("PoVendorInvoice", fields: [vendorInvoiceId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedAt   DateTime?

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(0) // optimistic concurrency (PRD §7.1)
  createdById String?
  updatedById String?

  @@unique([dataAreaId, poNumber])
  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItemId     String?
  stockItem       StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Decimal       @db.Decimal(18, 3) // ordered
  qtyReceived     Decimal       @default(0) @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 4)
  lineTotal       Decimal       @db.Decimal(18, 2) // quantity × unitPrice
  expenseCode     String        @default("5100") // non-stock lines charge here

  @@index([purchaseOrderId])
  @@index([stockItemId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  dataAreaId      String        @default("HQ01")
  receiptNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedAt      DateTime      @db.Date
  note            String?

  lines GoodsReceiptLine[]

  createdAt   DateTime @default(now())
  createdById String?

  @@unique([dataAreaId, receiptNumber])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String       @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  quantity            Decimal      @db.Decimal(18, 3) // received on this receipt

  // Inventory link — the stock movement this receipt line created (if a stock item).
  stockMovementId String?

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ───────────────────────── Payroll (M9) ─────────────────────────

model Employee {
  id          String         @id @default(cuid())
  dataAreaId  String         @default("HQ01")
  code        String // internal, e.g. EMP-000001
  name        String
  nationalId  String? // NIDA / national ID
  tin         String? // tax PIN/TIN
  country     String         @default("TZ") // ISO country → statutory scheme (TZ, KE …)
  grossSalary Decimal        @db.Decimal(18, 2) // monthly gross (base ccy)
  currency    String         @default("USD")
  status      EmployeeStatus @default(ACTIVE)
  bankAccount String?
  hiredAt     DateTime       @db.Date

  // ── Master data & demographics (spec: Payroll §1) ──
  jobTitle       String? // Long-Haul Driver / Dispatch / Warehouse Staff
  employmentType String? // Full-time / Contract / Agency
  department     String? // department / cost center
  costCenter     String?
  payFrequency   String? // Weekly / Bi-weekly / Monthly
  nssfNumber     String? // pension / social security
  shifNumber     String? // health insurance

  // ── Standing allowances (spec: Payroll §4) ──
  perDiem            Decimal @default(0) @db.Decimal(18, 2)
  overnightAllowance Decimal @default(0) @db.Decimal(18, 2)
  phoneAllowance     Decimal @default(0) @db.Decimal(18, 2)
  otherAllowance     Decimal @default(0) @db.Decimal(18, 2)
  // Optional link to a Driver record (a driver may also be an employee).
  driverId           String? @unique
  driver             Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  payslips         Payslip[]
  contracts        EmploymentContract[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  documents        EmployeeDocument[]
  timeEntries      TimeEntry[]
  timesheets       Timesheet[]
  assetAssignments AssetAssignment[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  version     Int     @default(0) // optimistic concurrency (PRD §7.1)
  createdById String?
  updatedById String?

  @@unique([dataAreaId, code])
  @@index([status])
  @@map("employees")
}

model PayRun {
  id         String       @id @default(cuid())
  dataAreaId String       @default("HQ01")
  year       Int
  month      Int // 1-12
  status     PayRunStatus @default(DRAFT)
  currency   String       @default("USD")
  grossTotal Decimal      @default(0) @db.Decimal(18, 2)
  payeTotal  Decimal      @default(0) @db.Decimal(18, 2)
  nssfTotal  Decimal      @default(0) @db.Decimal(18, 2)
  shifTotal  Decimal      @default(0) @db.Decimal(18, 2)
  netTotal   Decimal      @default(0) @db.Decimal(18, 2)
  memo       String?

  // Ledger link — the journal entry this run posted.
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("PayRunPosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedAt   DateTime?

  payslips  Payslip[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  version     Int     @default(0)
  createdById String?
  updatedById String?

  @@unique([dataAreaId, year, month])
  @@index([status])
  @@map("pay_runs")
}

model Payslip {
  id         String   @id @default(cuid())
  payRunId   String
  payRun     PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  gross      Decimal  @db.Decimal(18, 2)
  paye       Decimal  @db.Decimal(18, 2) // income tax
  nssf       Decimal  @db.Decimal(18, 2) // pension
  shif       Decimal  @db.Decimal(18, 2) // health
  net        Decimal  @db.Decimal(18, 2) // gross − paye − nssf − shif

  @@unique([payRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

// ───────────────────────── Expense Management (M23) ─────────────────────────

model ExpenseClaim {
  id          String             @id @default(cuid())
  dataAreaId  String             @default("HQ01")
  claimNumber String
  driverId    String?
  driver      Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  title       String // e.g. "Trip TRP-00012 cash sheet"
  currency    String             @default("USD")
  status      ExpenseClaimStatus @default(DRAFT)
  total       Decimal            @default(0) @db.Decimal(18, 2) // Σ line amounts

  // Advance reconciliation (M23) — the driver disbursement this claim settles.
  advanceId     String?        @unique
  advance       MoneyTransfer? @relation("ClaimAdvance", fields: [advanceId], references: [id], onDelete: SetNull)
  advanceAmount Decimal        @default(0) @db.Decimal(18, 2) // snapshot of the advance at reconcile
  reconciled    Decimal        @default(0) @db.Decimal(18, 2) // total − advanceAmount (+ = owed to driver, − = driver returns)

  // Ledger link
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("ExpenseClaimPosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedAt   DateTime?

  lines     ExpenseLine[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  version     Int     @default(0) // optimistic concurrency (PRD §7.1)
  createdById String?
  updatedById String?

  @@unique([dataAreaId, claimNumber])
  @@index([status])
  @@index([driverId])
  @@map("expense_claims")
}

model ExpenseLine {
  id             String       @id @default(cuid())
  expenseClaimId String
  expenseClaim   ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  expenseCode    String // COA expense account this line hits (5000/5030/…)
  description    String
  amount         Decimal      @db.Decimal(18, 2)
  incurredAt     DateTime     @db.Date
  receiptUrl     String? // uploaded proof-of-spend image (/uploads/…)

  @@index([expenseClaimId])
  @@map("expense_lines")
}

// ── Fixed Assets (M20) ──────────────────────────────────────────────────────
// Asset register with straight-line depreciation. Each depreciation run posts
// Dr Depreciation Expense (5200) / Cr Accumulated Depreciation (1510). Disposal
// removes the asset's cost + accumulated depreciation and books gain (4900) or
// loss (6900) against proceeds. Multi-tenant via dataAreaId.
model FixedAsset {
  id         String        @id @default(cuid())
  dataAreaId String        @default("HQ01")
  code       String // human asset tag, unique within a company
  name       String
  category   AssetCategory @default(EQUIPMENT)
  status     AssetStatus   @default(ACTIVE)

  acquisitionCost  Decimal  @db.Decimal(18, 2)
  residualValue    Decimal  @default(0) @db.Decimal(18, 2) // salvage value at end of life
  usefulLifeMonths Int // straight-line depreciation period
  acquisitionDate  DateTime @db.Date
  inServiceDate    DateTime @db.Date // depreciation starts from here

  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2) // running total, kept in sync with entries
  lastDepreciatedPeriod   String? // "YYYY-MM" of the most recent run; guards double-posting

  // GL account codes this asset posts against (defaulted from category, overridable).
  assetAccountCode String @default("1500")
  accumDepCode     String @default("1510")
  expenseCode      String @default("5200")

  // Disposal outcome (set once when status → DISPOSED).
  disposalDate     DateTime?     @db.Date
  disposalProceeds Decimal?      @db.Decimal(18, 2)
  disposalEntryId  String?       @unique
  disposalEntry    JournalEntry? @relation("AssetDisposalPosting", fields: [disposalEntryId], references: [id], onDelete: SetNull)

  // Warranty schedule (M19).
  warrantyProvider  String?
  warrantyExpiresAt DateTime? @db.Date

  entries     DepreciationEntry[]
  assignments AssetAssignment[]

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dataAreaId, code])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id           String     @id @default(cuid())
  dataAreaId   String     @default("HQ01")
  fixedAssetId String
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  period         String // "YYYY-MM" the depreciation belongs to
  amount         Decimal @db.Decimal(18, 2) // depreciation charged this period
  bookValueAfter Decimal @db.Decimal(18, 2) // net book value after this charge

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("DepreciationPosting", fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([fixedAssetId, period]) // one depreciation charge per asset per month
  @@index([dataAreaId])
  @@index([fixedAssetId])
  @@map("depreciation_entries")
}

// ── Service Management (M22) ────────────────────────────────────────────────
// Workshop service orders for the fleet. Parts are drawn from Inventory (each
// ServicePart issues stock via the inventory service, which posts Dr Maintenance
// (5100) / Cr Inventory (1300) and relieves the item). Labor is tracked per line;
// external (vendor) labor accrues to the ledger when the order is posted
// (Dr Maintenance 5100 / Cr Accrued 2300). Internal labor is a memo cost only,
// since own mechanics are already paid through Payroll. Multi-tenant via dataAreaId.
model ServiceOrder {
  id          String             @id @default(cuid())
  dataAreaId  String             @default("HQ01")
  orderNumber String
  vehicleId   String
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind        ServiceKind        @default(INTERNAL)
  status      ServiceOrderStatus @default(OPEN)

  // External garage (only when kind = EXTERNAL).
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  odometerKm Int? // reading at service time
  fault      String // reported problem / service reason
  currency   String @default("USD")

  // Cost rollups, kept in sync as parts/labor are added.
  partsCost Decimal @default(0) @db.Decimal(18, 2)
  laborCost Decimal @default(0) @db.Decimal(18, 2)
  totalCost Decimal @default(0) @db.Decimal(18, 2)

  // The labor-accrual posting created when an EXTERNAL order is posted.
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("ServiceOrderPosting", fields: [postingEntryId], references: [id], onDelete: SetNull)

  openedAt    DateTime  @default(now())
  completedAt DateTime?

  parts ServicePart[]
  labor ServiceLabor[]

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dataAreaId, orderNumber])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@index([vehicleId])
  @@map("service_orders")
}

// A part consumed on a service order. Issuing it relieves inventory and posts the
// cost; the link to the resulting StockMovement records the trail.
model ServicePart {
  id             String       @id @default(cuid())
  dataAreaId     String       @default("HQ01")
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  description String
  quantity    Decimal   @db.Decimal(18, 3)
  unitCost    Decimal   @db.Decimal(18, 2) // average cost at issue
  totalCost   Decimal   @db.Decimal(18, 2)

  // The inventory movement this part created (posts the GL relief).
  stockMovementId String? @unique

  createdAt DateTime @default(now())

  @@index([serviceOrderId])
  @@index([dataAreaId])
  @@map("service_parts")
}

// A labor line on a service order (own mechanic or external technician).
model ServiceLabor {
  id             String       @id @default(cuid())
  dataAreaId     String       @default("HQ01")
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  description String
  hours       Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(18, 2) // per-hour rate
  amount      Decimal @db.Decimal(18, 2) // hours × rate

  createdAt DateTime @default(now())

  @@index([serviceOrderId])
  @@index([dataAreaId])
  @@map("service_labor")
}

// ── Human Resources (M24) ──────────────────────────────────────────────────
// Layers contract history, leave management, and document-expiry tracking on top
// of the Employee record (which Payroll M9 already uses). Multi-tenant via
// dataAreaId. Activating a contract syncs the employee's current salary/status;
// approving a paid leave request deducts from that year's LeaveBalance.
model EmploymentContract {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        EmploymentType @default(PERMANENT)
  status      ContractStatus @default(DRAFT)
  title       String // job title / position
  grossSalary Decimal        @db.Decimal(18, 2) // monthly gross under this contract
  currency    String         @default("USD")
  startDate   DateTime       @db.Date
  endDate     DateTime?      @db.Date // required for FIXED_TERM / PROBATION
  note        String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataAreaId])
  @@index([employeeId])
  @@index([dataAreaId, status])
  @@map("employment_contracts")
}

model LeaveRequest {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      LeaveType   @default(ANNUAL)
  status    LeaveStatus @default(PENDING)
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  days      Int // working days requested (weekends excluded)
  reason    String?

  reviewedById String?
  reviewedAt   DateTime?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataAreaId])
  @@index([employeeId])
  @@index([dataAreaId, status])
  @@map("leave_requests")
}

// One row per employee / leave type / leave-year. `remaining` is derived
// (entitled − taken) and enforced when a paid request is approved.
model LeaveBalance {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type     LeaveType
  year     Int // leave year, e.g. 2026
  entitled Int       @default(0) // days granted for the year
  taken    Int       @default(0) // days consumed by approved requests

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, type, year])
  @@index([dataAreaId])
  @@map("leave_balances")
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      EmployeeDocType
  number    String? // document / certificate number
  issuedAt  DateTime?       @db.Date
  expiresAt DateTime?       @db.Date // null = never expires (e.g. a certificate)
  fileUrl   String? // uploaded scan (/uploads/…)
  note      String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, type])
  @@index([dataAreaId])
  @@index([expiresAt])
  @@map("employee_documents")
}

// ── Time & Attendance (M26) ─────────────────────────────────────────────────
// Clock-in/out records per employee, rolled up into a monthly Timesheet. An
// approved timesheet's overtime pay is picked up by the Payroll (M9) compute as
// an addition to base salary (taxable). Multi-tenant via dataAreaId. Biometric
// terminal ingestion is integration-gated (PRD §5); entries are MANUAL/MOBILE
// until a feed is wired.
model TimeEntry {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime         @db.Date
  clockIn  DateTime
  clockOut DateTime? // null = still clocked in
  source   AttendanceSource @default(MANUAL)
  note     String?

  // Set when the entry is rolled into a submitted/approved timesheet.
  timesheetId String?
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: SetNull)

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataAreaId])
  @@index([employeeId, workDate])
  @@index([timesheetId])
  @@map("time_entries")
}

// One timesheet per employee per pay period (YYYY-MM). Regular/overtime split is
// computed from that period's completed time entries against a standard workday.
model Timesheet {
  id         String   @id @default(cuid())
  dataAreaId String   @default("HQ01")
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  period        String // "YYYY-MM"
  status        TimesheetStatus @default(OPEN)
  regularHours  Decimal         @default(0) @db.Decimal(10, 2)
  overtimeHours Decimal         @default(0) @db.Decimal(10, 2)
  overtimeRate  Decimal         @default(0) @db.Decimal(18, 2) // per-hour OT pay rate
  overtimePay   Decimal         @default(0) @db.Decimal(18, 2) // overtimeHours × overtimeRate

  reviewedById String?
  reviewedAt   DateTime?

  entries TimeEntry[]

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@map("timesheets")
}

// ── Operational KPI capture (Tier C internal) ───────────────────────────────
// Records when a vehicle arrives at and departs a dock/yard, so truck-turnaround
// time (departure − arrival) can be computed without a telematics feed.
model DockEvent {
  id         String        @id @default(cuid())
  dataAreaId String        @default("HQ01")
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  facility   String? // dock / yard / warehouse name
  kind       DockEventKind
  eventAt    DateTime
  note       String?

  version     Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataAreaId])
  @@index([vehicleId, eventAt])
  @@index([tripId])
  @@map("dock_events")
}

// A cargo damage / loss claim on a delivered load — feeds the damage & claim-rate KPI.
model DamageReport {
  id           String       @id @default(cuid())
  dataAreaId   String       @default("HQ01")
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tripId       String?
  trip         Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  reportNumber String
  status       DamageStatus @default(REPORTED)
  reportedAt   DateTime     @db.Date
  cargoValue   Decimal      @default(0) @db.Decimal(18, 2) // value of the affected shipment
  damageValue  Decimal      @default(0) @db.Decimal(18, 2) // assessed damage / loss
  currency     String       @default("USD")
  description  String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dataAreaId, reportNumber])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@map("damage_reports")
}

// Manually-captured customer satisfaction (CSAT 1–5) and NPS (0–10) — the survey
// tool is a Tier C integration; until then this is entered by the account team.
model CustomerFeedback {
  id          String   @id @default(cuid())
  dataAreaId  String   @default("HQ01")
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  csat        Int? // 1–5 satisfaction score
  nps         Int? // 0–10 recommend score
  comment     String?
  collectedAt DateTime @db.Date

  version     Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataAreaId])
  @@index([customerId])
  @@map("customer_feedback")
}

// ───────────────────────── Sales & Marketing (M27) ─────────────────────────

// A CRM lead — a prospective client the sales team is pursuing. Kept lightweight;
// once WON it is typically turned into a Client + a SalesQuote.
model Lead {
  id             String    @id @default(cuid())
  dataAreaId     String    @default("HQ01")
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  source         String? // referral / web / campaign / cold-call
  stage          LeadStage @default(NEW)
  estimatedValue Decimal   @default(0) @db.Decimal(18, 2)
  currency       String    @default("USD")
  ownerId        String? // salesperson who owns the lead
  owner          User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes          String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes SalesQuote[]

  @@index([dataAreaId])
  @@index([dataAreaId, stage])
  @@map("leads")
}

// A freight quotation. Header holds routing + commercial terms; line items carry
// the priced services. On acceptance it can be converted to a freight Order.
model SalesQuote {
  id          String      @id @default(cuid())
  dataAreaId  String      @default("HQ01")
  quoteNumber String // QUO-000001, unique per company
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  salesperson String?
  status      QuoteStatus @default(DRAFT)

  // Routing snapshot (denormalized onto the quote; copied to the Order on convert).
  originZone       String?
  destinationZone  String?
  cargoDescription String?

  currency   String   @default("USD")
  total      Decimal  @default(0) @db.Decimal(18, 2) // Σ line amounts, maintained on write
  validUntil DateTime @db.Date
  notes      String?

  // Set when the quote is converted into a freight Order.
  convertedOrderId String? @unique
  convertedOrder   Order?  @relation("QuoteConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines SalesQuoteLine[]

  @@unique([dataAreaId, quoteNumber])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@index([clientId])
  @@map("sales_quotes")
}

model SalesQuoteLine {
  id          String     @id @default(cuid())
  dataAreaId  String     @default("HQ01")
  quoteId     String
  quote       SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal    @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal    @default(0) @db.Decimal(18, 2)
  amount      Decimal    @default(0) @db.Decimal(18, 2) // quantity × unitPrice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("sales_quote_lines")
}

// ───────────────────────── Project Management (M29) ─────────────────────────

// A project / contract grouping freight orders, tracked against a planned budget.
// Actual revenue & cost are rolled up from the linked orders and their trips.
model Project {
  id            String        @id @default(cuid())
  dataAreaId    String        @default("HQ01")
  projectCode   String // PRJ-000001, unique per company
  name          String
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager       String? // account / project manager
  status        ProjectStatus @default(PLANNING)
  currency      String        @default("USD")
  budgetRevenue Decimal       @default(0) @db.Decimal(18, 2) // planned billings
  budgetCost    Decimal       @default(0) @db.Decimal(18, 2) // planned direct cost
  startDate     DateTime?     @db.Date
  endDate       DateTime?     @db.Date
  description   String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@unique([dataAreaId, projectCode])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@index([clientId])
  @@map("projects")
}

// ───────────────────────── Master Planning (M33) ─────────────────────────

// A planner-entered demand forecast for a period + corridor: the expected number
// of loads and tonnage. The capacity plan compares the confirmed forecasts for a
// period against live fleet/driver availability to surface a shortfall or surplus.
// One forecast per (period, corridor) within a company.
model DemandForecast {
  id             String         @id @default(cuid())
  dataAreaId     String         @default("HQ01")
  period         String // planning bucket, e.g. "2026-08" (month) or "2026-W32" (week)
  corridor       CorridorType   @default(DOMESTIC)
  status         ForecastStatus @default(DRAFT)
  forecastLoads  Int            @default(0) // expected number of shipments
  forecastTonnes Decimal        @default(0) @db.Decimal(12, 2) // expected tonnage
  // Optional planner override of resources dedicated to this period+corridor.
  // When null, the live fleet/driver counts are used for the capacity comparison.
  plannedTrucks  Int?
  plannedDrivers Int?
  notes          String?

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dataAreaId, period, corridor])
  @@index([dataAreaId])
  @@index([dataAreaId, period])
  @@index([dataAreaId, status])
  @@map("demand_forecasts")
}

// ───────────────────────── Retail / POS (M28) ─────────────────────────

// An over-the-counter sale of stock items. On completion it relieves inventory
// and posts Dr Cash / Cr Retail Revenue (total) and Dr COGS / Cr Inventory (cost).
model PosSale {
  id            String           @id @default(cuid())
  dataAreaId    String           @default("HQ01")
  saleNumber    String // POS-000001, unique per company
  customerName  String? // walk-in name; null for anonymous
  paymentMethod PosPaymentMethod @default(CASH)
  status        PosSaleStatus    @default(DRAFT)
  currency      String           @default("USD")
  subtotal      Decimal          @default(0) @db.Decimal(18, 2) // Σ line totals (pre-tax)
  taxAmount     Decimal          @default(0) @db.Decimal(18, 2)
  total         Decimal          @default(0) @db.Decimal(18, 2) // subtotal + tax
  cogs          Decimal          @default(0) @db.Decimal(18, 2) // Σ line cost, set on completion
  note          String?
  completedAt   DateTime?

  // Ledger links created on completion.
  revenueEntryId String?       @unique
  revenueEntry   JournalEntry? @relation("PosRevenue", fields: [revenueEntryId], references: [id], onDelete: SetNull)
  cogsEntryId    String?       @unique
  cogsEntry      JournalEntry? @relation("PosCogs", fields: [cogsEntryId], references: [id], onDelete: SetNull)

  version     Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines PosSaleLine[]

  @@unique([dataAreaId, saleNumber])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@map("pos_sales")
}

model PosSaleLine {
  id          String    @id @default(cuid())
  dataAreaId  String    @default("HQ01")
  saleId      String
  sale        PosSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity    Decimal   @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal   @default(0) @db.Decimal(18, 2) // sale price per unit
  lineTotal   Decimal   @default(0) @db.Decimal(18, 2) // quantity × unitPrice
  unitCost    Decimal   @default(0) @db.Decimal(18, 4) // avgCost snapshot at completion
  lineCost    Decimal   @default(0) @db.Decimal(18, 2) // quantity × unitCost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([stockItemId])
  @@map("pos_sale_lines")
}

// ───────────────────────── Dynamic RBAC (role/permission management) ─────────────────────────

// The catalog of every permission key the app enforces (e.g. "order:read").
// Seeded from the code's permission list; the admin UI reads this to know which
// toggles to render per role.
model RbacPermission {
  key         String   @id // "order:read"
  description String?
  createdAt   DateTime @default(now())

  roles RbacRolePermission[]

  @@map("rbac_permissions")
}

// A role — either one of the 5 built-in system roles (isSystem=true, mirrors the
// Role enum by key) or a custom role created from the admin UI. Its permission
// grants live in RbacRolePermission.
model RbacRole {
  key         String   @id // "ADMIN", "DISPATCHER", or a custom key like "YARD_SUPERVISOR"
  name        String // human label
  description String?
  isSystem    Boolean  @default(false) // built-in; cannot be renamed-key/deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RbacRolePermission[]
  users       User[]

  @@map("rbac_roles")
}

// A single (role → permission) grant.
model RbacRolePermission {
  roleKey       String
  role          RbacRole       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permissionKey String
  permission    RbacPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@index([permissionKey])
  @@map("rbac_role_permissions")
}

// ───────────────────────── Fiscal calendar / period-close (M34) ─────────────────────────

enum PeriodStatus {
  OPEN
  CLOSED
}

// An accounting period (a calendar month) per legal entity. When CLOSED, the
// ledger refuses any new posting whose posting date falls in that month, which
// prevents back-dated edits to a signed-off month. A period with no row is OPEN
// by default, so enforcement only begins once a month is explicitly closed.
model FiscalPeriod {
  id         String       @id @default(cuid())
  dataAreaId String       @default("HQ01")
  year       Int
  month      Int // 1–12
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([dataAreaId, year, month])
  @@index([dataAreaId])
  @@index([dataAreaId, status])
  @@map("fiscal_periods")
}

// ───────────────────────── Product Information / attribute catalog (M16) ─────────────────────────

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  LIST // a fixed choice from `options`
}

// A definable product/stock attribute (e.g. "Viscosity", "Thread size"). Applies
// to one stock category or to all (category = null). Gives the parts catalog
// structured specs beyond the fixed columns.
model ProductAttribute {
  id         String            @id @default(cuid())
  dataAreaId String            @default("HQ01")
  key        String // machine key, unique per company (e.g. "viscosity")
  label      String // human label
  dataType   AttributeDataType @default(TEXT)
  unit       String? // e.g. "cSt", "mm", "V"
  options    String? // LIST: comma-separated choices
  category   StockCategory? // applies to this category only; null = all
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  values StockItemAttribute[]

  @@unique([dataAreaId, key])
  @@index([dataAreaId])
  @@map("product_attributes")
}

// A stock item's value for one attribute.
model StockItemAttribute {
  id          String           @id @default(cuid())
  dataAreaId  String           @default("HQ01")
  stockItemId String
  stockItem   StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([stockItemId, attributeId])
  @@index([attributeId])
  @@map("stock_item_attributes")
}

// ───────────────────────── Asset custody / assignment (M19) ─────────────────────────

// Who holds a fixed asset over time. The open assignment (returnedAt = null) is
// the current custodian; assigning a new one closes the previous. A custodian is
// an employee (FK) and/or a free-text label/location (a department or site).
model AssetAssignment {
  id          String     @id @default(cuid())
  dataAreaId  String     @default("HQ01")
  assetId     String
  asset       FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  custodian   String // holder label (employee name snapshot, department, or site)
  location    String?
  assignedAt  DateTime   @db.Date
  returnedAt  DateTime?  @db.Date
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([dataAreaId])
  @@index([assetId])
  @@index([assetId, returnedAt])
  @@map("asset_assignments")
}
